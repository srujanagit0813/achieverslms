// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
 
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}
model User {
  id             Int      @id @default(autoincrement())
  fullName       String   @db.VarChar(40) // App should validate min 3 characters
  email          String   @unique @db.VarChar(60)
  studentPhone   String?   @db.Char(10) // App should ensure 10-digit number
  parentPhone    String?   @db.Char(10)
  password       String   @db.VarChar(255) // Hashed password
   userImage      String?  // URL or file path of the user's profile picture
    role           String   @default("student") // can be 'student', 'instructor', or 'admin'
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model OTP {
  email     String   @id
  code      String
  expiresAt DateTime
}
model Course {
  id              Int       @id @default(autoincrement())
  title           String
  category        Category  @relation(fields: [categoryId], references: [id])
  categoryId   Int @default(1)
   instructor      String
  lessons         Int?
  duration        String       // Assuming duration is in minutes
  price           Float
  discountedPrice Float?
  isFree          Boolean   @default(false)
  thumbnail       String?
  rating          Float     @default(0)
  topics          Topic[]
  createdAt       DateTime  @default(now())
}
model Category {
  id      Int      @id @default(autoincrement())
  name    String
  courses Course[]
}
model Topic {
  id          Int        @id @default(autoincrement())
  title       String
  course      Course     @relation(fields: [courseId], references: [id])
  courseId    Int
  subtopics   Subtopic[]
}
model Subtopic {
  id          Int        @id @default(autoincrement())
  title       String
  topic       Topic      @relation(fields: [topicId], references: [id])
  topicId     Int
  lessons     Lesson[]
}

model Lesson {
  id          Int        @id @default(autoincrement())
  title       String
  videoUrl    String?    // optional
  pdfUrl      String?    // optional
  textContent String?    // optional
  subtopic    Subtopic   @relation(fields: [subtopicId], references: [id])
  subtopicId  Int
  assignments Assignment[]
  quizzes    Quiz[]
  returnTests ReturnTest[]
  projects    Project[]
}

model Assignment {
  id        Int     @id @default(autoincrement())
  title     String
  lesson    Lesson  @relation(fields: [lessonId], references: [id])
  lessonId  Int
  // Add fields for assignment details
}

model Quiz {
  id        Int     @id @default(autoincrement())
  title     String
  lesson    Lesson  @relation(fields: [lessonId], references: [id])
  lessonId  Int
  // Add quiz questions, etc.
}

model ReturnTest {
  id        Int     @id @default(autoincrement())
  title     String
  lesson    Lesson  @relation(fields: [lessonId], references: [id])
  lessonId  Int
}

model Project {
  id        Int     @id @default(autoincrement())
  title     String
  lesson    Lesson  @relation(fields: [lessonId], references: [id])
  lessonId  Int
}


model Exam {
  id         Int      @id @default(autoincrement())
  title      String   // e.g., "CBSE Class VI"
  logoUrl    String   // image/logo URL
  board      String   // e.g., "CBSE", "ICSE", "Punjab Board", or "Capgemini"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
