// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  fullName     String   @db.VarChar(40) // App should validate min 3 characters
  email        String   @unique @db.VarChar(60)
  studentPhone String?  @db.Char(10) // App should ensure 10-digit number
  parentPhone  String?  @db.Char(10)
  password     String   @db.VarChar(255) // Hashed password
  userImage    String? // URL or file path of the user's profile picture
  role         String   @default("student") // can be 'student', 'instructor', or 'admin'
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model OTP {
  email     String   @id
  code      String
  expiresAt DateTime
}

model AnimatedVideo {
  id         Int      @id @default(autoincrement())
  title      String
  subtitle   String
  buttonText String
  image      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Category {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Course {
  id             String      @id @default(cuid())
  category       String
  title          String
  lessons        Lesson[]
  duration       String
 actualPrice     Float   @default(0)
discountedPrice Float   @default(0)
 
  free           Boolean
  rating         Float
  video          String
  image          String
  lastUpdated    DateTime    @default(now())
  description    String      @db.Text
  instructor     Instructor  @relation(fields: [instructorId], references: [id])
  instructorId   String

  curriculum     Curriculum[]
  reviews        Review[]
}


model Instructor {
  id      String   @id @default(cuid())
  name    String
  bio     String
  courses Course[]
}

model Curriculum {
  id       String           @id @default(cuid())
  section  String
  duration String
  course   Course           @relation(fields: [courseId], references: [id])
  courseId String
  items    CurriculumItem[]
}

model CurriculumItem {
  id           String     @id @default(cuid())
  type         String
  title        String
  duration     String?
  preview      Boolean?
  locked       Boolean?
  questions    Int?
  curriculum   Curriculum @relation(fields: [curriculumId], references: [id])
  curriculumId String
}

model Review {
  id       String @id @default(cuid())
  user     String
  comment  String
  course   Course @relation(fields: [courseId], references: [id])
  courseId String
}

model Lesson {
  id       String          @id @default(cuid())
  title    String
  courseId String
  course   Course          @relation(fields: [courseId], references: [id])
  contents LessonContent[]
}

model LessonContent {
  id          String       @id @default(cuid())
  label       String
  type        ContentType
  duration    String? // only for videos
  url         String? // only for videos
  title       String? // only for assignment
  lessonId    String
  lesson      Lesson       @relation(fields: [lessonId], references: [id])
  assignments Assignment[]
  quizzes            Quiz[]
  materials Material[]
}

enum ContentType {
  video
  material
  quiz
  assignment
}

model Assignment {
  id              String        @id @default(cuid())
  title           String
  description     String
  dueDate         DateTime
  downloadLink    String
  submitStatus    String // e.g., "Submitted", "Not Submitted"
  status          String // e.g., "Pending", "Completed"
  lessonContent   LessonContent @relation(fields: [lessonContentId], references: [id])
  lessonContentId String
}
model Quiz {
  id        String        @id @default(cuid())
  label     String
  questions Int
  duration  Int
  marks     Int
  lessonContent   LessonContent @relation(fields: [lessonContentId], references: [id])
  lessonContentId String
  quizQuestions QuizQuestion[]
}

model QuizQuestion {
  id       String   @id @default(cuid())
  question String
  options  Json     // JSON array like ["A", "B", "C", "D"]
  answer   String
  quizId   String
  quiz     Quiz     @relation(fields: [quizId], references: [id])
}


model Material {
  id          String   @id @default(cuid())
  label       String
  type        MaterialType
  pages       Int?
  size        String?
  link        String
  download    String
  description String?
  author      String?
  lessonContent   LessonContent @relation(fields: [lessonContentId], references: [id])
  lessonContentId String
}

enum MaterialType {
  PDF
  Video
  Image
}